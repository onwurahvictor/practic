# Copy this file to .env for local `netlify dev`, and set the same
# values as environment variables in the Netlify dashboard for production.

# Connection string from your Postgres host (Neon, Supabase, or Railway all
# have a free tier). Must include ?sslmode=require if the host needs it.
DATABASE_URL=postgres://user:password@host/dbname

# Any long random string. This gates /api/enquiries (the admin log).
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=change-me-to-a-long-random-string
